# Required in production: long random string used to sign session cookies.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# fal.ai API key (https://fal.ai/dashboard/keys). Leave empty to run in MOCK mode:
# every generation succeeds with placeholder media and costs no real money.
FAL_KEY=

# Database. Defaults to a local SQLite file. For serverless hosting (Vercel etc.)
# point this at a Turso/libSQL database and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Credits every new account starts with.
SIGNUP_CREDITS=100
